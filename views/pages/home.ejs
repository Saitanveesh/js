<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>SwapShelf</title>
  <meta name="description" content="Share books and study notes with students nearby.">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#home">SwapShelf</a>
    <nav>
      <button data-page="home">Home</button>
      <button data-page="browse">Browse</button>
      <button data-page="create">List a resource</button>
      <button id="admin-button">Admin</button>
    </nav>
  </header>

  <main>
    <section id="home-page" class="page active hero">
      <div>
        <p class="eyebrow">Student resource exchange</p>
        <h1>Books and notes should circulate, not collect dust.</h1>
        <p>List academic material, browse nearby resources, and contact the owner directly.</p>
        <button class="primary" data-page="browse">Browse resources</button>
      </div>
      <div class="stats">
        <article><strong id="total-listings">0</strong><span>Listings</span></article>
        <article><strong id="total-books">0</strong><span>Books</span></article>
        <article><strong id="total-notes">0</strong><span>Notes</span></article>
      </div>
    </section>

    <section id="browse-page" class="page">
      <div class="section-head"><div><p class="eyebrow">Available now</p><h2>Browse resources</h2></div></div>
      <div class="filters">
        <input id="search-input" type="search" placeholder="Search title, subject, tag or location">
        <select id="type-filter"><option value="">All types</option><option>BOOK</option><option>NOTES</option></select>
        <select id="condition-filter"><option value="">All conditions</option><option>Excellent</option><option>Good</option><option>Fair</option></select>
      </div>
      <div id="listing-grid" class="grid"></div>
      <p id="empty-state" class="empty hidden">No matching resources.</p>
    </section>

    <section id="create-page" class="page narrow">
      <p class="eyebrow">Add material</p><h2>List a resource</h2>
      <form id="listing-form" enctype="multipart/form-data">
        <div class="two"><label>Type<select name="type" required><option value="BOOK">Book</option><option value="NOTES">Notes</option></select></label><label>Condition<select name="condition" required><option>Excellent</option><option>Good</option><option>Fair</option></select></label></div>
        <label>ISBN, optional<div class="inline"><input id="isbn" inputmode="numeric" placeholder="978..."><button type="button" id="isbn-button">Look up</button></div></label>
        <label>Title<input id="title" name="title" maxlength="160" required></label>
        <label>Author or subject<input id="author_subject" name="author_subject" maxlength="160" required></label>
        <label>Description<textarea id="description" name="description" rows="5" maxlength="2000" required></textarea></label>
        <div class="two"><label>Location<input name="location" maxlength="160" required></label><label>Owner email<input name="owner_email" type="email" required></label></div>
        <label>Tags<input name="tags" placeholder="Algorithms, Semester 3, CSE"></label>
        <label>Images<input name="images" type="file" multiple accept="image/jpeg,image/png,image/webp"></label>
        <button class="primary" type="submit">Submit resource</button>
      </form>
    </section>

    <section id="admin-page" class="page">
      <div class="section-head"><div><p class="eyebrow">Moderation</p><h2>Admin dashboard</h2></div><button id="logout-button">Log out</button></div>
      <div id="admin-grid" class="grid"></div>
    </section>
  </main>

  <dialog id="listing-dialog"><button class="close" data-close>×</button><div id="listing-detail"></div></dialog>
  <dialog id="contact-dialog"><button class="close" data-close>×</button><h2>Contact owner</h2><form id="request-form"><input type="hidden" name="owner_email"><input type="hidden" name="resource_title"><label>Your name<input name="requester_name" required></label><label>Your email<input name="requester_email" type="email" required></label><label>Message<textarea name="message" rows="5" required></textarea></label><button class="primary">Send request</button></form></dialog>
  <dialog id="login-dialog"><button class="close" data-close>×</button><h2>Admin login</h2><form id="login-form"><label>Username<input name="username" required></label><label>Password<input name="password" type="password" required></label><button class="primary">Log in</button></form></dialog>
  <div id="toast" class="toast hidden" role="status"></div>
  <script>window.SWAPSHELF_ADMIN = <%- JSON.stringify(isAdmin) %>;</script>
  <script src="/js/app.js"></script>
</body>
</html>
