{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swapshelf",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*", "/health", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swapshelf",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "preview_database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "swapshelf-uploads",
      "preview_bucket_name": "swapshelf-uploads-preview"
    }
  ]
}
