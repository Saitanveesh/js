{
  "name": "swapshelf",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native student resource sharing application.",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --check src/worker.js && node --check public/js/app.js",
    "test": "node --test",
    "ci": "npm run check && npm test",
    "deploy": "wrangler deploy",
    "preview": "wrangler versions upload",
    "db:migrate:local": "wrangler d1 migrations apply swapshelf --local",
    "db:migrate:remote": "wrangler d1 migrations apply swapshelf --remote"
  },
  "author": "Sai Tanveesh",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
